+// Rendering-only effects: no notification objects, actions or timers are retained.
+// At most eight clipped snapshots and twenty-eight deterministic stars per card.
+static double kira_now(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1000000.0;
+}
+static void kira_clear(struct kira_card *card) {
+    if (card->image) cairo_pattern_destroy(card->image);
+    *card = (struct kira_card){0};
+}
+static void kira_tick(void *data) {
+    struct mako_surface *surface = data;
+    surface->kira_timer = NULL;
+    set_dirty(surface);
+}
+static void kira_schedule(struct mako_surface *surface) {
+    if (!surface->kira_timer)
+        surface->kira_timer = add_event_loop_timer(&surface->state->event_loop, 20, kira_tick, surface);
+}
+// Stable per-notification variation: no random allocation or ongoing simulation.
+static double kira_random(uint32_t seed) {
+    seed ^= seed >> 16; seed *= 0x7feb352dU;
+    seed ^= seed >> 15; seed *= 0x846ca68bU; seed ^= seed >> 16;
+    return (seed & 0xffffU) / 65535.0;
+}
+static void kira_star(cairo_t *cr, double r, bool glint) {
+    cairo_move_to(cr,-r,0);
+    cairo_line_to(cr,-r*.19,-r*.19);
+    cairo_line_to(cr,0,-r*(glint ? 1.45 : 1));
+    cairo_line_to(cr,r*.19,-r*.19); cairo_line_to(cr,r,0);
+    cairo_line_to(cr,r*.19,r*.19);
+    cairo_line_to(cr,0,r*(glint ? 1.45 : 1));
+    cairo_line_to(cr,-r*.19,r*.19); cairo_close_path(cr); cairo_fill(cr);
+}
+static void kira_stars(cairo_t *cr, const struct kira_card *card, double age, bool closing) {
+    if (age >= (closing ? 560 : 780) || age < 0) return;
+    cairo_save(cr); cairo_scale(cr, card->scale, card->scale);
+    // Effects stay in a bounded side corridor. Gutters and margins in render.c
+    // keep the longer paths inside the surface and out of adjacent card text.
+    for (int i=0; i<28; ++i) {
+        uint32_t seed=card->id*7919U+(uint32_t)i*101U+(closing ? 97U : 0U);
+        double a=kira_random(seed), b=kira_random(seed+1), c=kira_random(seed+2);
+        double delay=(i%7==0 ? 90 : 0)+kira_random(seed+3)*(closing ? 65 : 130);
+        double life=(closing ? 240 : 340)+kira_random(seed+4)*(closing ? 160 : 220);
+        double t=(age-delay)/life;
+        if (t<0 || t>1) continue;
+        double side=a>.42 ? 1 : -1;
+        double travel=14+28*b;
+        double ease=1-pow(1-t,2.1+1.8*c);
+        double x=card->box.x+(side>0 ? card->box.width : 0)+side*(2+travel*ease);
+        double safe_height=fmax(0,card->box.height-40);
+        double y=card->box.y+card->box.height/2+(a-.5)*safe_height;
+        y+=(kira_random(seed+5)-.5)*10*t+(kira_random(seed+6)-.5)*10*sin(M_PI*t);
+        bool glint=i%7==0;
+        if (glint) {
+            double vertical=i%14 ? 1 : -1;
+            y=card->box.y+(vertical>0 ? card->box.height-5 : 5);
+            y+=vertical*10*ease+(kira_random(seed+6)-.5)*4*sin(M_PI*t);
+        }
+        double r=(glint ? 5.5 : 2.4+5.8*c)*(0.65+0.35*sin(M_PI*t));
+        double alpha=fmin(1,t*9)*pow(1-t,.8)*(glint ? 1 : .95);
+        double red=i%3==0 ? 1 : i%2 ? .72 : .39;
+        double green=i%3==0 ? .94 : i%2 ? .68 : .78;
+        double blue=i%3==0 ? .78 : i%2 ? .87 : .75;
+        cairo_save(cr); cairo_translate(cr,x,y);
+        cairo_rotate(cr,(kira_random(seed+7)-.5)*1.8+(kira_random(seed+8)-.5)*3*t);
+        cairo_pattern_t *glow=cairo_pattern_create_radial(0,0,0,0,0,r*1.8);
+        cairo_pattern_add_color_stop_rgba(glow,0,red,green,blue,alpha*.38);
+        cairo_pattern_add_color_stop_rgba(glow,1,red,green,blue,0);
+        cairo_set_source(cr,glow); cairo_arc(cr,0,0,r*1.8,0,2*M_PI); cairo_fill(cr);
+        cairo_pattern_destroy(glow);
+        cairo_set_source_rgba(cr,red,green,blue,alpha); kira_star(cr,r,glint);
+        if (glint) { // A delayed white inner flash, not another persistent particle.
+            cairo_rotate(cr,.4); cairo_set_source_rgba(cr,1,1,1,alpha*.9);
+            kira_star(cr,r*.45,true);
+        }
+        cairo_restore(cr);
+    }
+    cairo_restore(cr);
+}
+static struct kira_card *kira_slot(struct mako_surface *surface, uint32_t id) {
+    struct kira_card *empty = NULL;
+    for (int i=0; i<KIRA_SLOTS; ++i) {
+        struct kira_card *c=&surface->kira[i];
+        if (c->id == id) return c;
+        if (!c->id) empty=c;
+    }
+    return empty; // Excess notifications render normally; memory never grows.
+}
